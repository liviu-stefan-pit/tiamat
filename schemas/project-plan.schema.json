{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiamat.local/schemas/project-plan.schema.json",
  "title": "ProjectPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "title",
    "summary",
    "assumptions",
    "risks",
    "phases",
    "finalGates"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "runId": { "type": "string", "format": "uuid" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "phases": {
      "type": "array",
      "items": { "$ref": "#/$defs/phase" }
    },
    "finalGates": {
      "type": "array",
      "items": { "$ref": "#/$defs/finalGate" }
    }
  },
  "$defs": {
    "testKind": {
      "type": "string",
      "enum": [
        "unit",
        "integration",
        "e2e",
        "manual",
        "diff",
        "review",
        "artifact",
        "cleanup"
      ]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phaseId",
        "title",
        "objective",
        "dependencies",
        "projectIds",
        "readRoots",
        "writeRoots",
        "modelTier",
        "estimatedMinutes",
        "acceptanceCriteria",
        "unitTests",
        "integrationTests",
        "e2eTests",
        "manualChecks",
        "rollback",
        "expectedArtifacts",
        "prompt",
        "status",
        "evidence"
      ],
      "properties": {
        "phaseId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "objective": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "projectIds": { "type": "array", "items": { "type": "string" } },
        "readRoots": { "type": "array", "items": { "type": "string" } },
        "writeRoots": { "type": "array", "items": { "type": "string" } },
        "modelTier": {
          "type": "string",
          "enum": ["composer", "grok-low", "grok-medium", "grok-high"]
        },
        "estimatedMinutes": { "type": "integer", "minimum": 1 },
        "acceptanceCriteria": {
          "type": "array",
          "items": { "$ref": "#/$defs/acceptanceCriterion" }
        },
        "unitTests": {
          "type": "array",
          "items": { "$ref": "#/$defs/testSpec" }
        },
        "integrationTests": {
          "type": "array",
          "items": { "$ref": "#/$defs/testSpec" }
        },
        "e2eTests": {
          "type": "array",
          "items": { "$ref": "#/$defs/testSpec" }
        },
        "manualChecks": {
          "type": "array",
          "items": { "$ref": "#/$defs/manualCheck" }
        },
        "rollback": { "$ref": "#/$defs/rollback" },
        "expectedArtifacts": { "type": "array", "items": { "type": "string" } },
        "prompt": { "type": "string" },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "ready",
            "queued",
            "running",
            "verifying",
            "passed",
            "failed",
            "blocked",
            "cancelled",
            "skipped",
            "needs_review"
          ]
        },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "description", "requiredEvidenceKinds"],
      "properties": {
        "criterionId": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "requiredEvidenceKinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/testKind" }
        }
      }
    },
    "testSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testId",
        "command",
        "workingDirectory",
        "timeoutSeconds",
        "resourceLocks",
        "expected",
        "covers"
      ],
      "properties": {
        "testId": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "workingDirectory": { "type": "string" },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "resourceLocks": { "type": "array", "items": { "type": "string" } },
        "expected": { "$ref": "#/$defs/testExpected" },
        "covers": { "type": "array", "items": { "type": "string" } },
        "inapplicableReason": { "type": "string" }
      }
    },
    "testExpected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exitCode", "artifacts"],
      "properties": {
        "exitCode": { "type": "integer" },
        "artifacts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "manualCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "blocking"],
      "properties": {
        "description": { "type": "string" },
        "blocking": { "type": "boolean" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint", "strategy"],
      "properties": {
        "checkpoint": { "type": "string" },
        "strategy": {
          "type": "string",
          "enum": ["restore", "quarantine"]
        }
      }
    },
    "finalGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateId", "description", "dependencies", "requiredEvidenceKinds"],
      "properties": {
        "gateId": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "requiredEvidenceKinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/testKind" }
        }
      }
    }
  }
}
