{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tiamat",
  "version": "0.1.0",
  "identifier": "com.tiamat.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tiamat",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "digestAlgorithm": "sha256",
      "tsp": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Tiamat",
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "languages": ["English"],
        "template": null,
        "compression": "lzma"
      },
      "wix": {
        "language": "en-US",
        "template": null,
        "fragmentPaths": [],
        "componentGroupRefs": [],
        "componentRefs": [],
        "featureGroupRefs": [],
        "featureRefs": [],
        "mergeRefs": [],
        "upgradeCode": "A1B2C3D4-E5F6-4789-A012-3456789ABCDE"
      }
    },
    "publisher": "Tiamat",
    "shortDescription": "Turn rough project material into tested implementations",
    "longDescription": "Tiamat orchestrates Cursor CLI agents on Windows with isolated workspaces, structured verification, and deterministic process cleanup. Uninstall retains unpromoted managed workspaces."
  }
}
